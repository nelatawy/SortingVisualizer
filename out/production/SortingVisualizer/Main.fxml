<AnchorPane fx:id="arrayGenScene" minHeight="600.0" minWidth="600.0" prefHeight="400.0" prefWidth="600.0" styleClass="scene" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="FxController">
   <children>
      <HBox fx:id="barContainer" alignment="CENTER" layoutX="32.0" layoutY="236.0" prefHeight="255.0" prefWidth="536.0" />
      <Button layoutX="307.0" layoutY="106.0" mnemonicParsing="false" onAction="#generateRandomArray" prefHeight="46.0" prefWidth="229.0" text="Generate Random Array" wrapText="true" />
      <ComboBox id="arrayModeSelector" fx:id="algorithmSelector" layoutX="66.0" layoutY="106.0" prefHeight="46.0" prefWidth="229.0" promptText="Array Mode" />

      <Button layoutX="67.0" layoutY="519.0" mnemonicParsing="false" onAction="#sort" prefHeight="59.0" prefWidth="229.0" text="Visualize a Sorting Algorithm" />
      <Label fx:id="title" contentDisplay="CENTER" layoutX="7.0" layoutY="14.0" prefHeight="59.0" prefWidth="584.0" text="Array Generator" textAlignment="CENTER">
         <font>
            <Font size="32.0" />
         </font>
      </Label>
      <Label layoutX="247.0" layoutY="206.0" prefHeight="18.0" prefWidth="105.0" text="Preview">
         <font>
            <Font size="21.0" />
         </font>
      </Label>
      <Button layoutX="307.0" layoutY="519.0" mnemonicParsing="false" onAction="#sort" prefHeight="59.0" prefWidth="229.0" text="Compare Between Algorithms" />
      <TextField fx:id="fromField" layoutX="66.0" layoutY="164.0" prefHeight="27.0" prefWidth="60.0" text="From" />
      <TextField fx:id="toField" layoutX="136.0" layoutY="164.0" prefHeight="27.0" prefWidth="69.0" text="To" />
      <TextField fx:id="size" layoutX="217.0" layoutY="164.0" prefHeight="27.0" prefWidth="77.0" text="Size" />
   </children>
</AnchorPane>
