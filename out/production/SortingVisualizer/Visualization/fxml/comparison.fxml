<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Visualization.Controllers.ComparisonController">
    <VBox alignment="CENTER" spacing="20.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
        <Label fx:id="title" contentDisplay="CENTER" prefHeight="45.0" prefWidth="600.0" text="Algorithm Comparison" textAlignment="CENTER">
            <font>
                <Font size="26.0" />
            </font>
        </Label>
        
        <VBox fx:id="topBar" alignment="CENTER">

            <Label text="Algorithms" />
            <HBox fx:id="algorithmCheckboxes" />

            <Label text="Runs" />
            <TextField fx:id="runCount" />


            <Button fx:id="compare_button" onAction="#runComparison" text="Start Comparison" />
        </VBox>
        <HBox alignment="CENTER" prefHeight="100.0" prefWidth="406.0">
            <Button mnemonicParsing="false" onAction="#saveAlgorithmStats" text="Save Stats" />
            <Button mnemonicParsing="false" onAction="#resetAlgorithmStats" text="Reset" />
        </HBox>
        <TableView id="stats" fx:id="algorithmStats" prefHeight="255.0" prefWidth="600.0" />
      <Button mnemonicParsing="false" onAction="#goToArrayGen" prefHeight="27.0" prefWidth="210.0" text="Generate another array" />
    </VBox>

    <HBox alignment="CENTER" AnchorPane.bottomAnchor="-180.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0">
        <VBox fx:id="toast" alignment="CENTER" prefHeight="150.0" prefWidth="300.0">
            <Label fx:id="toastHeader" alignment="CENTER" prefHeight="24.0" prefWidth="249.0" />
        </VBox>
    </HBox>

</AnchorPane>
