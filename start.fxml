<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.text.Font?>

<?import javafx.scene.control.TextField?>
<AnchorPane fx:id="arrayGenScene" prefHeight="700.0" prefWidth="1000.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="arrayGenController">
   <children>
      <Label fx:id="title" contentDisplay="CENTER" layoutX="208.0" layoutY="20.0" prefHeight="59.0" prefWidth="584.0" text="Array Generator" textAlignment="CENTER">
         <font>
            <Font size="32.0" />
         </font>
      </Label>
      <ComboBox id="arrayModeSelector" fx:id="algorithmSelector" layoutX="261.0" layoutY="116.0" prefHeight="59.0" prefWidth="229.0" promptText="Array Mode" />
      <Button layoutX="510.0" layoutY="116.0" mnemonicParsing="false" onAction="#generateRandomArray" prefHeight="59.0" prefWidth="229.0" text="Generate Array" wrapText="true" />
      <TextField fx:id="fromField" layoutX="66.0" layoutY="164.0" prefHeight="27.0" prefWidth="60.0" text="From" />
      <TextField fx:id="toField" layoutX="136.0" layoutY="164.0" prefHeight="27.0" prefWidth="69.0" text="To" />
      <TextField fx:id="size" layoutX="217.0" layoutY="164.0" prefHeight="27.0" prefWidth="77.0" text="Size" />
      <Label layoutX="448.0" layoutY="206.0" prefHeight="18.0" prefWidth="105.0" text="Preview">
         <font>
            <Font size="21.0" />
         </font>
      </Label>
      <HBox fx:id="barContainer" alignment="CENTER" layoutX="182.0" layoutY="240.0" prefHeight="255.0" prefWidth="636.0" />
      <Button layoutX="261.0" layoutY="540.0" mnemonicParsing="false" onAction="#sort" prefHeight="59.0" prefWidth="229.0" text="Visualize a Sorting Algorithm" />
      <Button layoutX="510.0" layoutY="540.0" mnemonicParsing="false" onAction="#sort" prefHeight="59.0" prefWidth="229.0" text="Compare Between Algorithms" />
   </children>
</AnchorPane>
